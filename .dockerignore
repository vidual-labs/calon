# Build and test artifacts — never needed in the image.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
venv/
.venv/
env/
.env
data/
*.db
*.sqlite3
config/calon.toml
*.log
dist/
build/
*.egg-info/
src/*.egg-info/

# The example config ships with the image; operators edit their own copy at
# runtime. We keep the file itself (it's a template), not the runtime instance.
git/
.git/
.gitignore

# Development tooling.
CLAUDE.md
Makefile
py.typed
tests/
docs/
CHANGELOG.md
README.md
LICENSE
*.html
Dockerfile.dockerignore

# Python type-checking artefacts.
mypy.ini
pyrightconfig.json
