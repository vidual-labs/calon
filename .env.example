# calon runtime settings. Copy to .env and adjust.
# Operator scheduling rules live in config/calon.toml, not here.

# --- Core ---------------------------------------------------------------------
# Path to the SQLite database file. This file is the entirety of your booking
# state — back it up. It is created, and its schema migrated, at startup.
CALON_DB_PATH=./data/calon.db

# Public base URL of this instance. Used to build absolute links in calendar
# handoffs, so it must match how requesters actually reach calon.
CALON_BASE_URL=http://localhost:8000

# Hostname used for the domain part of the iCalendar UID
# ("<booking-id>@<host>"). Keep this STABLE for the life of the instance:
# changing it means previously issued calendar events can no longer be updated
# in place and will duplicate instead.
CALON_INSTANCE_HOST=localhost

# Path to the operator configuration file. It is re-read at every startup and
# overwrites the rules calon holds in the database, so editing this file and
# restarting is the whole configuration workflow. Leave it empty to run on the
# built-in defaults, which are the ones config/calon.example.toml documents.
CALON_CONFIG_PATH=./config/calon.toml

# --- Operational --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
CALON_LOG_LEVEL=INFO

# Set to false in production. Controls the interactive /docs endpoint.
CALON_DOCS_ENABLED=true

# --- Security -------------------------------------------------------------------
# The operator login. This single key gates the operator web panel (the login
# form at /login and the dashboard at /bookings) and the calendar handoff
# (the .ics endpoint, which carries a requester's name and subject).
#
# - It is not a per-user account; calon has one operator, and this is that key.
# - Strongly recommended in production: set CALON_LOGIN and run behind TLS so
#   the session cookie is not sent in cleartext.
# - If left empty, the operator panel and the .ics endpoint return 503 (the
#   instance is *unsecured* rather than open); the public booking API still
#   works.
CALON_LOGIN=

# Optional shared API key for programmatic access to operator endpoints
# (Authorization: Bearer <CALON_API_KEY>). Set this if you want to script the
# operator panel with curl, or integrate an external system. When unset, only
# the cookie-based login works. Leave empty to disable the Bearer path.
CALON_API_KEY=

# How long an operator web session lives before it requires re-login (hours).
CALON_SESSION_TTL_HOURS=12

# Requests per minute per IP against the public booking form.
# Not applied yet: the form arrives in phase 4, and so does this limit.
CALON_RATE_LIMIT_PER_MINUTE=10
